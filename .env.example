# Universal AI Agent - Environment Variables
# Copy this file to .env and fill in your values

# Groq API Key (required)
GROQ_API_KEY=your_groq_api_key_here

# Groq OpenAI-compatible endpoint (optional; defaults to https://api.groq.com/openai/v1)
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Model to use (default: llama-3.1-70b-versatile)
GROQ_MODEL=llama-3.1-70b-versatile

# Max tokens for response
MAX_TOKENS=1500

# Hotkey configuration (optional overrides)
HOTKEY_ANALYZE=ctrl+shift+a
HOTKEY_HIDE=ctrl+shift+h
HOTKEY_CAPTURE=ctrl+shift+c
HOTKEY_REFRESH=ctrl+shift+r
